NAME = Na_c1_casscf_soc.inp
|  1> ! RHF aug-cc-pVTZ SARC/J VeryTightSCF SC-NEVPT2

|  2> %scf

|  3>   MaxIter 500

|  4> end

|  5> %casscf

|  6>   nel 8

|  7>   norb 8

|  8>   mult 1,3

|  9>   nroots 5,5

| 10>   MaxIter 200

| 11>   rel

| 12>     DoSOC true

| 13>   end

| 14> end

| 15> * xyz 1 1

| 16> Na 0.0 0.0 0.0

| 17> *

| 18> 
| 19>                          ****END OF INPUT****
